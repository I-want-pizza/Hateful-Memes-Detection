# =============================================================================
# .env.example — Copy to .env and fill in your values.
# .env is in .gitignore and must NEVER be committed.
# =============================================================================

# ── Local dataset path (Windows) ──────────────────────────────────────────────
# Used only for upload_code.ps1; on remote the path is always "data"
DATA_DIR=

# ── Dataset location on Yandex Disk ──────────────────────────────────────────
# Path to the dataset archive on Yandex Disk (zip or tar.gz)
# Example: disk:/hateful_memes/data.zip
YADISK_DATASET_PATH=

# ── Weights & Biases ──────────────────────────────────────────────────────────
# Get your key at: https://wandb.ai/settings
WANDB_API_KEY=
WANDB_PROJECT=

# ── Training ──────────────────────────────────────────────────────────────────
DEVICE=cuda        # cuda | cpu
NUM_WORKERS=4      # use 0 on Windows if DataLoader crashes

# ── Remote machine (vast.ai or any SSH server) ────────────────────────────────
REMOTE_USER=root
REMOTE_IP=your.server.ip.here
REMOTE_PORT=22     # vast.ai uses a non-standard port (e.g. 56416)
REMOTE_PATH=~/hateful_memes

# ── Local folder to sync results into ────────────────────────────────────────
LOCAL_RESULTS_DIR=D:\path\to\results

# ── Yandex Disk (for uploading checkpoints + full backups from remote server) ─
# OAuth token — get at: https://oauth.yandex.ru  (app: "Яндекс.Диск" scope)
YADISK_TOKEN=your_yadisk_oauth_token_here
# Root folder on Yandex Disk
YADISK_PATH=
# Split threshold for full backup (GB). Default: 5. Increase if network is stable.
BACKUP_CHUNK_GB=5
